<script>
function pengeluaranApp() {
    return {
        search: '',
        filterCategory: '',
        showModal: false,
        showDeleteModal: false,
        modalMode: 'add',
        deleteItem: null,
        editId: null,
        form: { date: new Date().toISOString().split('T')[0], description: '', category: '', amount: '' },
        pengeluaran: [
            { id: 1, date: '2024-08-14', description: 'Pembelian Gas Elpiji 3kg', category: 'Operasional', amount: 100000 },
            { id: 2, date: '2024-08-13', description: 'Pembayaran Listrik Bulan Agustus', category: 'Utilitas', amount: 250000 },
            { id: 3, date: '2024-08-10', description: 'Sewa Tempat Bulan Agustus', category: 'Sewa', amount: 500000 },
            { id: 4, date: '2024-08-08', description: 'Beli Beras 10kg', category: 'Bahan Baku', amount: 120000 },
            { id: 5, date: '2024-08-05', description: 'Beli Sayur dan Bumbu', category: 'Bahan Baku', amount: 85000 },
            { id: 6, date: '2024-08-01', description: 'Pembersihan AC', category: 'Operasional', amount: 150000 },
            { id: 7, date: '2024-07-28', description: 'Pembayaran Air', category: 'Utilitas', amount: 75000 },
        ],
        get filteredPengeluaran() {
            return this.pengeluaran.filter(item => {
                const matchSearch = item.description.toLowerCase().includes(this.search.toLowerCase());
                const matchCategory = !this.filterCategory || item.category === this.filterCategory;
                return matchSearch && matchCategory;
            });
        },
        get filteredTotal() {
            return this.filteredPengeluaran.reduce((sum, item) => sum + item.amount, 0);
        },
        get totalPengeluaran() {
            return this.pengeluaran.reduce((sum, item) => sum + item.amount, 0);
        },
        get todayTotal() {
            const today = new Date().toISOString().split('T')[0];
            return this.pengeluaran.filter(p => p.date === today).reduce((sum, p) => sum + p.amount, 0);
        },
        get monthTotal() {
            const currentMonth = new Date().toISOString().slice(0, 7);
            return this.pengeluaran.filter(p => p.date.startsWith(currentMonth)).reduce((sum, p) => sum + p.amount, 0);
        },
        kategoriClass(cat) {
            const map = {
                'Operasional': 'text-success-600',
                'Bahan Baku':  'text-primary-600',
                'Utilitas':    'text-warning-600',
                'Sewa':        'text-danger-600',
                'Lainnya':     'text-inkmuted',
            };
            return map[cat] || 'text-inkmuted';
        },
        formatTanggal(iso) {
            if (!iso) return '-';
            const d = new Date(iso + 'T00:00:00');
            if (isNaN(d)) return iso;
            return d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
        },
        openAddModal() {
            this.modalMode = 'add';
            this.form = { date: new Date().toISOString().split('T')[0], description: '', category: '', amount: '' };
            this.showModal = true;
        },
        openEditModal(item) {
            this.modalMode = 'edit';
            this.editId = item.id;
            this.form = { ...item };
            this.showModal = true;
        },
        openDeleteModal(item) {
            this.deleteItem = item;
            this.showDeleteModal = true;
        },
        savePengeluaran() {
            // Cegah nilai minus pada jumlah
            if (Number(this.form.amount) < 0) this.form.amount = 0;
            if (!this.form.date || !this.form.description || !this.form.category || !this.form.amount) return;
            if (this.modalMode === 'add') {
                const newId = Math.max(...this.pengeluaran.map(p => p.id), 0) + 1;
                this.pengeluaran.unshift({ ...this.form, id: newId });
            } else {
                const idx = this.pengeluaran.findIndex(p => p.id === this.editId);
                if (idx !== -1) this.pengeluaran[idx] = { ...this.form, id: this.editId };
            }
            this.showModal = false;
        },
        confirmDelete() {
            if (this.deleteItem) {
                this.pengeluaran = this.pengeluaran.filter(p => p.id !== this.deleteItem.id);
            }
            this.showDeleteModal = false;
            this.deleteItem = null;
        },
        formatRupiah(num) {
            return 'Rp ' + Number(num).toLocaleString('id-ID');
        }
    }
}
</script>
