            // Shortcut: "/" fokus ke pencarian, Escape menutup modal
            window.addEventListener('keydown', (e) => {
                if (e.key === '/' && document.activeElement !== this.$refs.search) {
                    e.preventDefault();
                    this.$refs.search.focus();
                }
                if (e.key === 'Escape') {
                    this.showSuccessModal = false;
                }
            });
        }
    }
}
